# Storage backend for exports: 'local' or 's3'
EXPORT_STORAGE=local

# If using S3, provide bucket and credentials
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# Other env examples
JWT_SECRET=change_this_in_prod
DATABASE_URL=file:./dev.db# Copy to .env and update
DATABASE_URL=postgresql://postgres:postgres@db:5432/vision_ngo
PORT=4000
JWT_SECRET=replace-with-a-secure-secret
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
