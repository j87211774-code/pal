{
  "name": "vision-ngo-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "test": "jest --runInBand",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "@prisma/client": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.1",
    "prisma": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "@types/jest": "^29.5.2",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  }
}
